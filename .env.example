# --- Модель (как в статье: совместимый с OpenAI API эндпоинт) ---
# Для облачного OpenAI base_url можно не указывать.
LLM_BASE_URL=https://api.openai.com/v1
LLM_KEY=sk-...ваш_ключ...
LLM_NAME=gpt-4o-mini

# --- LangSmith: трассировка прогонов графа ---
# Включает запись каждого шага (router → субагент → инструмент) в проект LangSmith.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...ваш_ключ...
LANGSMITH_PROJECT=research-assistant

# Примечание: эти же переменные docker-compose подставляет в сервис
# langgraph-server (${LLM_*}, ${LANGSMITH_*}). Адреса Postgres/Redis/RabbitMQ
# и URL графа для backend заданы прямо в docker-compose.yml — менять их в .env
# не нужно.
